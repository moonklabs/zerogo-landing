{
  "name": "zerogo-landing",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "kill-port 3001 && next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "tsc --noEmit",
    "clean": "rm -rf .next out",
    "publish": "tsx scripts/publish-post.ts",
    "promote": "tsx scripts/promote.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:ci": "vitest run --reporter=junit --outputFile=junit.xml",
    "coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:ci": "playwright test --reporter=junit"
  },
  "dependencies": {
    "@channel.io/channel-web-sdk-loader": "^2.0.2",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.1.0",
    "posthog-js": "^1.396.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.14",
    "@tailwindcss/typography": "^0.5.16",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^17.2.3",
    "jsdom": "^29.0.2",
    "kill-port": "^2.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.4"
  }
}
