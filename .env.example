# Google Apps Script Auth Key
GAS_AUTH_KEY=my_zero098aidl_secret_123

# GitHub OAuth App (dev/staging only — not needed in production)
DECAP_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
DECAP_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Content API (for external AI agent integration)
GITHUB_TOKEN=ghp_your_github_personal_access_token
GITHUB_OWNER=moonklabs
GITHUB_REPO=zerogo-landing
GITHUB_BRANCH=dev
  
# API Key storage file (JSON file for storing hashed API keys)
API_KEYS_FILE=.api-keys.json
  

# Build trigger (optional - for auto-rebuild on content change)
ENABLE_CONTENT_AUTO_BUILD=true
