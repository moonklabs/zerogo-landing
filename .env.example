# ── Application form (/api/apply → Google Apps Script) ──────────────────────
# Server-side only. The apply route refuses to run without GAS_AUTH_KEY.
GAS_URL=your_google_apps_script_webhook_url
GAS_AUTH_KEY=your_gas_auth_key

# Slack incoming webhook for new-signup notifications (optional)
SLACK_WEBHOOK_URL=

# ── Deployment environment gate (CRITICAL) ──────────────────────────────────
# Set DEPLOY_ENV=production on the Amplify `main` branch so middleware.ts
# HARD-BLOCKS /admin (Decap CMS) in production (zerogo.ai). On the `dev` branch
# leave it unset or set to "development" so dev.zerogo.ai keeps serving /admin.
DEPLOY_ENV=development

# ── Google Tag Manager (GA4 + Meta/Facebook Pixel managed in GTM) ────────────
# Add GA4 and Meta Pixel tags inside the GTM container, not directly in code.
# Leave blank to disable GTM on local/dev environments.
NEXT_PUBLIC_GTM_ID=

# ── Optional PostHog browser/direct capture for landing CTA clicks ───────────
# URL attribution to the app works without this. Set these only when landing
# should emit `landing_cta_clicked` directly to PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Channel Talk anonymous support widget ───────────────────────────────────
NEXT_PUBLIC_CHANNEL_TALK_PLUGIN_KEY=

# Exact dashboard origins allowed to embed /preview. Comma-separated HTTPS
# origins only. Leave blank to keep production live preview disabled.
LANDING_PREVIEW_ALLOWED_ORIGINS=

# Compile-time allowlist for direct immutable hero JPG/PNG delivery.
# Keep this exact value; missing or different values reject all absolute media URLs.
NEXT_PUBLIC_LANDING_MEDIA_GCS_PUBLIC_BASE=https://storage.googleapis.com/zerogo-494800-landing-media-prod

# ── Decap CMS GitHub OAuth (dev only) ───────────────────────────────────────
# Used by the cloudflare-workers/decap-oauth worker, not the Next app.
DECAP_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
DECAP_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# 실험 랜딩 변형 config (zerogo-backend) — 미설정 시 기본 문구만 렌더
LANDING_CONFIG_API_BASE=https://api.zerogo.ai
# 발행/롤백 revalidate 훅 보호 시크릿 (zerogo-backend의 LANDING_REVALIDATE_SECRET과 동일해야 함)
LANDING_REVALIDATE_SECRET=
