# ── Application form (/api/apply → Google Apps Script) ──────────────────────
# Server-side only. The apply route refuses to run without GAS_AUTH_KEY.
GAS_URL=your_google_apps_script_webhook_url
GAS_AUTH_KEY=your_gas_auth_key

# Slack incoming webhook for new-signup notifications (optional)
SLACK_WEBHOOK_URL=

# ── Deployment environment gate (CRITICAL) ──────────────────────────────────
# Set DEPLOY_ENV=production on the Amplify `main` branch so middleware.ts
# HARD-BLOCKS /admin (Decap CMS) in production (zerogo.ai). On the `dev` branch
# leave it unset or set to "development" so dev.zerogo.ai keeps serving /admin.
DEPLOY_ENV=development

# ── Optional PostHog browser/direct capture for landing CTA clicks ───────────
# URL attribution to the app works without this. Set these only when landing
# should emit `landing_cta_clicked` directly to PostHog.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ── Decap CMS GitHub OAuth (dev only) ───────────────────────────────────────
# Used by the cloudflare-workers/decap-oauth worker, not the Next app.
DECAP_GITHUB_CLIENT_ID=your_github_oauth_app_client_id
DECAP_GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret
